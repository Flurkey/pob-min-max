# Local engine checkout. scripts/bootstrap_engine.sh fills .pob/ and these can stay unset.
# POB_SRC=/absolute/path/to/PathOfBuilding/src
# POB_LUA=/absolute/path/to/luajit
# POB_UTF8_DIR=/absolute/path/to/dir/containing/lua-utf8.so
# POB_RUNTIME=/absolute/path/to/dir/whose/lua/ folder holds xml.lua and dkjson.lua
# POB_USER=/absolute/path/to/writable/pob-user-dir

# Web app. The Next.js dev server proxies /api to this process.
ENGINE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:8000
