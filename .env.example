# Local engine checkout. scripts/bootstrap_engine.sh fills .pob/ and these can stay unset.
# POB_SRC=/absolute/path/to/PathOfBuilding/src
# POB_LUA=/absolute/path/to/luajit
# POB_UTF8_DIR=/absolute/path/to/dir/containing/lua-utf8.so
# POB_RUNTIME=/absolute/path/to/dir/whose/lua/ folder holds xml.lua and dkjson.lua
# POB_USER=/absolute/path/to/writable/pob-user-dir
# Local SQLite library. This is not a Path of Building Builds folder.
# POB_LIBRARY=/absolute/path/to/library.sqlite
# Generated item, gem, and passive-tree database. Not committed.
# POB_KNOWLEDGE=/absolute/path/to/knowledge.sqlite

# Web app. The Next.js dev server proxies /api to this process.
ENGINE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:8000

# Optional model providers. Leave these unset in git. The agent tests use a fake
# provider and do not read or send a key. Put a real key only in an uncommitted .env.
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
